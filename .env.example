# Variable de entorno de base de datos provista por Render (Neon) o SQLite en local
DATABASE_URL=

# Configuración de Django
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=

# CORS y CSRF (URLs del frontend en Vercel y local)
