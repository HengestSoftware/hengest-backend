CSRF_TRUSTED_ORIGINS=

# URL del Frontend
FRONTEND_URL=

# Integración con Wompi
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Versión de Python para Render
PYTHON_VERSION=3.12.10
